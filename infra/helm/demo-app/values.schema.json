{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentStrategy": {
      "enum": [
        "canary",
        "blue-green"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "faultMode": {
          "enum": [
            "healthy",
            "http500",
            "latency"
          ]
        },
        "faultDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "successRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "p95Milliseconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimumRequests": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 2
        },
        "consecutiveSuccessLimit": {
          "type": "integer",
          "minimum": 1
        },
        "failureLimit": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusiveLimit": {
          "type": "integer",
          "minimum": 0
        },
        "window": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(s|m)$"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        }
      }
    },
    "canary": {
      "type": "object",
      "properties": {
        "manualApproval": {
          "type": "boolean"
        },
        "observationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
